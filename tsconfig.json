{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    // moduleResolution intentionally omitted: it's inferred from module=CommonJS.
    // Setting it explicitly (node10/"Node") is deprecated and needs ignoreDeprecations.
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}